# FinancialOS — PRODUCTION .env ŞABLONU (MA3, Wave-8)
# ⚠️ Bu bir ŞABLON: değerler PLACEHOLDER. Canlı sunucuda kopyala → GERÇEK secret'larla doldur:
#     cp .env.prod.example .env.prod   (.env.prod .gitignore'da, ASLA commit'lenmez)
# Gerçek secret'lar YALNIZ sunucudaki .env.prod'da yaşar; bu şablona veya git'e/chat'e GİRMEZ.

# ── Ortam + güvenlik kapıları (ZORUNLU) ──
ENVIRONMENT=production          # fail-fast + /docs kapalı (SEC-015) + prod hardening
AUTH_ENABLED=true              # JWT zorunlu (public deploy)

# ── Saat dilimi (BUG #169) — konteyner varsayılanı UTC'dir ──
# Uygulama yerel tarih kullanır (günlük limit, işlem tarihi, ay sınırı, cron saatleri).
# UTC bırakılırsa TR'de gece 00:00–03:00 arası işlemler BİR ÖNCEKİ güne yazılır ve
# "gece 02:45" fiyat cron'u 05:45'te koşar. Kullanıcı kitlesinin saat dilimini yaz.
TZ=Europe/Istanbul

# ── SECRET_KEY (ZORUNLU) — boş/zayıf ile uygulama BAŞLAMAZ (BUG #157 fail-fast) ──
# Üret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_python_secrets_token_urlsafe_48

# ── Veritabanı (Postgres) — RLS için app NON-superuser 'financialos' rolüyle bağlanır (ADR-038) ──
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# DATABASE_URL compose'ta financialos:${POSTGRES_PASSWORD}@db:5432/financialos olarak kurulur (elle set etme).

# ── Domain (ZORUNLU) — nginx server_name + Let's Encrypt cert ──
DOMAIN=financialos.example.com         # gerçek alan adın (IP-only için de gerçek domain önerilir)
# EMAIL yalnız init-letsencrypt.sh için (export EMAIL=...), .env.prod'a şart değil.

# ── LLM sağlayıcı (koç) — en az 1 anahtar ──
LLM_PROVIDER=fallback
GEMINI_API_KEY=REPLACE_OR_LEAVE_EMPTY
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Opsiyonel ──
CORS_ORIGINS=                          # aynı-origin (nginx) → genelde boş bırak
WEB_CONCURRENCY=2                      # gunicorn uvicorn worker sayısı (1-2 kullanıcı için 2 yeter)
# SMTP (davet/şifre-sıfırlama e-postası) — kullanılıyorsa:
# SMTP_HOST=  SMTP_PORT=  SMTP_USER=  SMTP_PASSWORD=  SMTP_FROM=
# OAuth (Google/GitHub) — kullanılıyorsa:
# BUG #189: degisken adlari KODLA ayni olmali (app/services/oauth.py) — eskiden bu satirda
# GOOGLE_CLIENT_ID yaziyordu, kod OAUTH_ onekini bekliyor -> operator dogru doldursa bile
# OAuth sessizce "yapilandirilmamis" (501) donuyordu.
# OAUTH_GOOGLE_CLIENT_ID=  OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=  OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=https://<domain>   # callback tabani (saglayici konsolunda kayitli olmali)

# ── Koc maliyet tavani (ADR-041, BUG #188) ──
# Kullanici BASINA gunluk LLM cagri tavani. Koc mesaji basina 2 cagri yapilir
# (iki-gecis mimarisi) -> 80 cagri ~ 40 mesaj/gun. Saglayici kotasi PAYLASILDIGI icin
# bu tavan hem maliyet hem ADALET guard'idir (tek kullanici herkesi kilitleyemez).
# 0 = kapali (onerilmez).
COACH_DAILY_USER_LIMIT=80

# -- Kapali beta (P7, BUG #199) --
# invite_only = yalniz davet kodu olan kayit olabilir (PRODUCTION VARSAYILANI, fail-closed)
# open        = herkese acik kayit (ACIK BETA'ya gecerken, BILINCLI olarak)
# Davet kodu uret:  python -m scripts.beta_invite --email <adres> --note "<kim>"
REGISTRATION_MODE=invite_only
