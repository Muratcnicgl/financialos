#!/usr/bin/env bash
# W3-058 (ONERI #030) — commit-öncesi test kapısı.
# BUG #061 (H2G5 gizli regresyon, 38 test sessizce kırıldı) tam da testler commit
# öncesi çalıştırılmadığı için sızmıştı. Bu hook staged dosyalara göre ilgili süiti koşar.
#
# Kurulum: git config core.hooksPath .githooks   (veya scripts/install-hooks.sh)
# Atlama (WIP): git commit --no-verify   (bilinçli, sorumluluk sende)
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged="$(git diff --cached --name-only --diff-filter=ACM)"

# Python (backend/test) değişti mi?
if echo "$staged" | grep -qE '^(app/|tests/|scripts/|alembic/).*\.py$'; then
  echo "[pre-commit] Python değişikliği — pytest çalışıyor (hızlı, ilk hatada durur)…"
  py="./venv/Scripts/python.exe"
  [ -x "$py" ] || py="python"
  if ! "$py" -m pytest tests/ -q -x --tb=short -p no:cacheprovider; then
    echo "[pre-commit] ❌ TESTLER KIRMIZI — commit engellendi. Düzelt veya bilinçliyse --no-verify."
    exit 1
  fi
  echo "[pre-commit] ✅ pytest yeşil."
fi

# Frontend değişti mi?
if echo "$staged" | grep -qE '^frontend/src/.*\.(js|jsx)$'; then
  if [ -d frontend/node_modules/vitest ]; then
    echo "[pre-commit] Frontend değişikliği — vitest çalışıyor…"
    ( cd frontend && npx vitest run ) || {
      echo "[pre-commit] ❌ vitest KIRMIZI — commit engellendi."
      exit 1
    }
    echo "[pre-commit] ✅ vitest yeşil."
  else
    echo "[pre-commit] ⚠ frontend/node_modules yok — vitest atlandı (npm install gerekli)."
  fi
fi

# ── UZAKTAKİ DURUM (BUG #295-#300) ────────────────────────────────────────────
# Bu hook yalnız YEREL süiti bilir. GitHub Actions 30+ koşum boyunca kırmızı kaldı ve
# kimse fark etmedi: yerel yeşil, uzak ölü. CI farklı OS, farklı Node/npm sürümü, `.env`
# YOKLUĞU ve gerçek bir PostgreSQL ile koşar — o turda bulunan altı defektin dördü
# yalnızca orada görünüyordu.
# `--sessiz`: yeşilse hiç konuşmaz. Commit'i ASLA engellemez (ağ yoksa/kota dolduysa
# çalışma durmamalı); amacı uyarmak, kapı olmak değil.
if [ -x ./venv/Scripts/python.exe ]; then
  ./venv/Scripts/python.exe -m scripts.ci_durum --sessiz 2>/dev/null || true
elif command -v python3 >/dev/null 2>&1; then
  python3 -m scripts.ci_durum --sessiz 2>/dev/null || true
fi

# ── CANLI SERVİS (BUG #328) ───────────────────────────────────────────────────
# Kapalı beta 3-4 Eylül 2026'da **24,5 saat kapalı kaldı ve kimse fark etmedi**: her
# başarısız açılış `logs/servis.log`'a yazıldı (45 deneme) ve o dosyaya kimse bakmadı.
# BUG #326 o ÖZEL arızayı (uygulanmamış göç) kendi kendine çözüyor; ama bir sonraki
# açılış hatası yine sessizce sürerdi (L61: ölçen sistem, HABER VEREN sistem değildir).
# Çare yeni bir kanal icat etmek değil, `ci_durum` deseninin aynısı: operatörün zaten
# her gün yaptığı işe bir satır iliştir.
# `--sessiz`: ayaktaysa hiç konuşmaz. Commit'i ASLA engellemez — servis kapalıyken commit
# atamamak, tam da onu onaracak commit'i engellerdi.
if [ -x ./venv/Scripts/python.exe ]; then
  ./venv/Scripts/python.exe -m scripts.canli_durum --sessiz 2>/dev/null || true
elif command -v python3 >/dev/null 2>&1; then
  python3 -m scripts.canli_durum --sessiz 2>/dev/null || true
fi

exit 0
