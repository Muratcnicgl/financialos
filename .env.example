# !! BUG #317 — NOTU DEGERIN YANINA YAZMA.
# python-dotenv, deger VARSA satir sonu yorumunu ayiklar (`X=abc  # not` -> `abc`), ama
# deger BOSSA ayiklamaz: `X=   # not` -> degerin kendisi `# not` olur. Bu sablonda 13
# degisken boyle yazilmisti; kopyalayan herkeste `LLM_MODEL`, `ANTHROPIC_API_KEY` gibi
# alanlar YORUM METNI tasiyordu ve sagayicilar "kota/erisim" gibi gorunen hatalar veriyordu.
# KURAL: bos birakilan bir degiskenin notu, satirin USTUNE yazilir.
# Kapi: tests/test_env_yorum_tuzagi_kapisi.py
# Ortam: development | production (M16 - production'da SECRET_KEY fail-fast)
ENVIRONMENT=development

# LLM Provider API Keys
# Get your keys from:
#   Groq:       https://console.groq.com/keys
#   Cerebras:   https://cloud.cerebras.ai/
#   Gemini:     https://aistudio.google.com/apikey
#   OpenRouter: https://openrouter.ai/keys
#
# At least one provider key is required. The FallbackProvider
# skips unconfigured providers automatically.

GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Provider mode: "fallback" uses the chain, or set to a specific
# provider name (groq | cerebras | gemini | openrouter) to pin one.
LLM_PROVIDER=fallback

# CORS — izin verilen frontend origin'leri (virgülle ayrılmış).
# Prod'da kendi domain'ini ver: CORS_ORIGINS=https://financialos.example.com
# Boş bırakılırsa dev default (localhost:5173/3000) kullanılır. (W3-040)
CORS_ORIGINS=

# === PRODUCTION (deployment — docs/deployment/README.md) ===
# Reverse-proxy domain'i (Caddy otomatik HTTPS için). Dev: localhost
DOMAIN=localhost
# Prod DB yolu (Docker'da /data volume). Dev: sqlite:///./data/financialos.db
# DATABASE_URL=sqlite:////data/financialos.db
# Oturum/JWT gizli anahtarı (M11 auth ile kullanılacak — şimdiden üret):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# === AUTH (Wave-3 M11 / ADR-033) ===
# BUG #227 (D06): varsayılan AÇIK (fail-closed). Tanımsız/boş bırakırsan JWT ZORUNLUDUR.
# Kimliksiz tek-kullanıcı yerel kurulumu istiyorsan AÇIKÇA `AUTH_ENABLED=false` yaz —
# ama internete açık hiçbir sunucuda bunu yapma (tüm finansal veri + hesap silme açılır).
AUTH_ENABLED=true
ACCESS_TTL_MIN=30            # access token ömrü (dakika)
REFRESH_TTL_DAYS=30         # refresh token ömrü (gün)
# OAuth (API_KEY_TALEP — docs/api-key-talep-wave3.md):
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# SMTP (şifre sıfırlama — API_KEY_TALEP: Brevo/Sendgrid free tier):
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM: gönderen adres (Brevo'da doğrulanmış olmalı)
SMTP_FROM=
SMTP_FROM_NAME=FinancialOS
# Şifre sıfırlama linkindeki frontend adresi (mail içindeki bağlantı):
FRONTEND_URL=http://localhost:5173

# TCMB EVDS v3 (M19 doviz/altin — evds3.tcmb.gov.tr Profilim > API Key Kopyala; header auth)
EVDS_API_KEY=

# === Koç ek ücretsiz sağlayıcılar (M13/ADR-034 revize — API_KEY_TALEP) ===
# TOGETHER_API_KEY: together.ai free (Llama 3.3 70B)
TOGETHER_API_KEY=
# TOGETHER_MODEL: opsiyonel model override
TOGETHER_MODEL=
# DEEPINFRA_API_KEY: deepinfra.com free tier
DEEPINFRA_API_KEY=
# DEEPINFRA_MODEL: opsiyonel
DEEPINFRA_MODEL=

# OAuth callback base (Google/GitHub konsolunda kayitli redirect URI ile eslesmeli):
#   <base>/api/auth/callback/google  ve  <base>/api/auth/callback/github
OAUTH_REDIRECT_BASE=http://localhost:8000

# === Rate Limit (M21 — auth endpoint, production degerleri) ===
# Varsayilan: login 5/900s, register 3/3600s, pwreset 3/3600s, oauth 10/60s
# Override: RATE_LIMIT_LOGIN_MAX=5 RATE_LIMIT_LOGIN_WINDOW=900 (bucket: LOGIN/REGISTER/PWRESET/OAUTH)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900

# === Logging (M23) ===
LOG_DIR=logs
LOG_ROTATION_MAX_MB=10
LOG_ROTATION_BACKUP=5

# === SPA SUNUMU (BUG #284) ===
# Derlenmis arayuzu backend'in kendisi sunsun mu (nginx'siz kurulum).
# ACIKKEN `frontend/dist/index.html` YOKSA UYGULAMA HIC ACILMAZ — app/spa.py
# bilerek fail-fast eder. Once: cd frontend && npm run build
SERVE_SPA=
# Derlenmis arayuzun dizini (repo disi kurulum). Bos = <repo>/frontend/dist
SPA_DIST=

# === GUVENLIK BASLIKLARI / PROXY ===
HSTS_ENABLED=1              # 0/false/no/off ile kapatilir
# Istemci IP'sini X-Forwarded-For'dan oku. YALNIZ guvenilir bir reverse-proxy
# arkasindaysan ac; aksi halde rate-limit taklit edilebilir (app/rate_limit.py).
TRUST_PROXY_HEADERS=

# === KAYIT / E-POSTA DOGRULAMA ===
# 1/0 ile ezilir. Bos birakilirsa: production + acik kayitta ZORUNLU, aksi halde kapali.
# Development'ta acmak kayit akisini kilitler (SMTP yok).
REQUIRE_EMAIL_VERIFICATION=

# === ZAMANLAYICI (APScheduler) ===
SCHEDULER_ENABLED=true      # 0/false/no ile kapatilir

# === LOG SEVIYESI ===
LOG_LEVEL=INFO

# === VERITABANI HAVUZU (yalniz PostgreSQL; SQLite'ta yok sayilir) ===
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800        # saniye (30 dk) — bayat baglanti kesilir

# === STOPAJ / GETIRI ESIGI (Wave-K) ===
# Koc vergi aritmetigi YAPMAZ; kural motoru hesaplar (app/vergi.py).
# Oranlar mevzuatla degisir; kod dagitmadan buradan guncellenir. Bos = koddaki
# olculmus varsayilan (1 Eyl 2026 itibariyla %17,5).
STOPAJ_TRY_MEVDUAT_6AY=
STOPAJ_TRY_PARA_PIYASASI_FONU=
# Oran bu gunden eskiyse cikti `bayat=True` gelir; hesap durmaz, koc teyit ister.
STOPAJ_TAZELIK_GUN=

# === LLM AYARLARI ===
LLM_TIMEOUT=60              # saniye
# ANTHROPIC_API_KEY: opsiyonel ek saglayici (app/coach.py)
ANTHROPIC_API_KEY=
# MODEL SECIMI (BUG #313) — model adi SAGLAYICIYA aittir, zincire degil.
# Oncelik: <ONEK>_MODEL > (yalniz LLM_PROVIDER o saglayiciyi adlandirdiginda) LLM_MODEL
#          > saglayicinin kendi DEFAULT_MODEL'i
# LLM_MODEL: YALNIZ LLM_PROVIDER tek bir saglayiciyi adlandirdiginda uygulanir.
#            LLM_PROVIDER=fallback iken HICBIR saglayiciya uygulanmaz (heterojen
#            zincir tek model adini paylasamaz).
LLM_MODEL=
# GEMINI_MODEL: opsiyonel (default: gemini-2.5-flash-lite)
GEMINI_MODEL=
# ANTHROPIC_MODEL: opsiyonel (default: claude-opus-4-8)
ANTHROPIC_MODEL=
# GROQ_MODEL: opsiyonel (default: openai/gpt-oss-120b)
GROQ_MODEL=
# CEREBRAS_MODEL: opsiyonel (default: gpt-oss-120b)
CEREBRAS_MODEL=
# OPENROUTER_MODEL: opsiyonel (default: meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=
# Reflection yalniz Groq uzerinden kosar; sirayla denenir (8B once, 70B fallback).
REFLECTION_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile
# Ollama (yerel model — opsiyonel):
OLLAMA_ENABLED=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# OLLAMA_TIMEOUT: bos = LLM_TIMEOUT x 2
OLLAMA_TIMEOUT=

# === OAUTH ===
OAUTH_TIMEOUT=15            # saniye (Google/GitHub token degisimi)

# === FINANSAL VARSAYILANLAR ===
ANOMALY_THRESHOLD=1.4       # harcama anomali esigi (kat — app/rules_engine.py)
INFLATION_ANNUAL=0.40       # yillik enflasyon varsayimi (0.40 = %40)
SAFE_DEBT_BUFFER=2000       # "guvenli borc odemesi" acil-durum tamponu (TL, FEAT-031)

# === SURUM DAMGASI ===
# Imaj icinde git yoksa surumu buradan okur. Bos = "bilinmiyor" (app/version.py)
BUILD_COMMIT=
