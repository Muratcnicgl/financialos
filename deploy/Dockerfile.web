# FinancialOS frontend — production (MA1, Wave-8): Vite build → nginx serve.
# nginx: SPA statik + /api reverse-proxy backend'e (HTTPS/güvenlik başlıkları MA2 nginx.conf'ta).
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
# MA2: default config kaldır; HTTPS template'i koy. nginx entrypoint envsubst ile ${DOMAIN}'i doldurur.
RUN rm /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf.template /etc/nginx/templates/financialos.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1
